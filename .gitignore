*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtuelle Umgebung (gemeinsames venv wird nie eingecheckt)
.venv/
venv/
env/

# Logs: alle .log-Dateien und Log-Verzeichnisse
*.log
log/
logs/

# Secrets und Zugangsdaten
.env
*.env
*_env
.*_env
